param set-default CA_ROTOR2_PX 0.13
param set-default CA_ROTOR2_PY -0.13
param set-default CA_ROTOR2_KM -0.023
param set-default CA_ROTOR2_CT 15.0

param set-default CA_ROTOR3_PX -0.13
param set-default CA_ROTOR3_PY 0.13
param set-default CA_ROTOR3_KM -0.023
param set-default CA_ROTOR3_CT 15.0

