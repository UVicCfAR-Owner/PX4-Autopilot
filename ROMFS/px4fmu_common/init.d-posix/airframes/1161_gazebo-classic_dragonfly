	param set-default MPC_Z_VEL_MAX_UP 5.0
	param set-default MPC_Z_VEL_MAX_DN 2.5
	
	param set-default MPC_Z_V_AUTO_UP 4.0
	param set-default MPC_Z_V_AUTO_DN 2.0
	
	param set-default MPC_YAW_MODE 3
	
