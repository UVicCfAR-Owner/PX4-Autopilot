	param set-default MC_YAWRATE_K 0.7
	param set-default MC_YAWRATE_P 0.15
	param set-default MC_YAWRATE_I 0.15
	param set-default MC_YAWRATE_D 0.02
	
	#Attitude controller
	param set-default MC_PITCH_P 2.5 # 3.5
	param set-default MC_ROLL_P 2.5  # 3.5
	param set-default MC_YAW_P 1.5
	
	#Position Controller
	param set-default MPC_TILTMAX_AIR 65
	param set-default MPC_MAN_TILT_MAX 65
	
	param set-default MPC_THR_HOVER 0.25
