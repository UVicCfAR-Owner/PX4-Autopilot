	param set-default MC_PITCHRATE_K 1.1
	param set-default MC_PITCHRATE_P 0.15 # 0.14
	param set-default MC_PITCHRATE_I 0.20 # 0.25
	param set-default MC_PITCHRATE_D 0.010
